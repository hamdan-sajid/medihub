# Supabase — Project Settings -> API
# The anon key is public by design; RLS restricts it to reads plus artifact
# review. The service_role key must never appear in this file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Agent server. http://localhost:8787 for local dev, the Render URL in production.
NEXT_PUBLIC_AGENT_URL=http://localhost:8787
