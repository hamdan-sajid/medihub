# --- Browser (public) --------------------------------------------------------
# The anon key is public by design: it ships to the browser and RLS restricts it
# to reads plus artifact approval.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server (secret) ---------------------------------------------------------
# The agent runs inside this app at /api/runs, so it needs the same credentials
# the standalone agent server used. These are NOT prefixed NEXT_PUBLIC — they
# must never reach the browser.
SUPABASE_URL=https://your-project.supabase.co
# Bypasses RLS. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

MEDIHUB_PROVIDER=google
# Free, no card: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional overrides — see apps/agent/.env.example for the full list.
# MEDIHUB_MODEL=gemini-3.5-flash-lite
# MEDIHUB_RPM=10

# --- Optional: run the agent as a separate service ---------------------------
# Leave unset to run the agent inside this app (recommended: same-origin, no
# CORS). Set it to a standalone apps/agent server to use that instead — that
# server must then list this app's origin in its ALLOWED_ORIGINS.
# NEXT_PUBLIC_AGENT_URL=http://localhost:8787
