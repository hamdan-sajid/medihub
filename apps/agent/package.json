{
  "name": "agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "//exports": "Compiled output, not source. The source uses Node ESM './run.js' specifiers, which bundlers cannot map back to .ts — so the web app consumes dist/ instead, built by its prebuild step.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "try": "tsx src/scripts/try-run.ts",
    "doctor": "tsx src/scripts/doctor.ts",
    "watch": "tsx src/scripts/watch.ts",
    "clean-runs": "tsx src/scripts/clean-runs.ts",
    "test-reviewer": "tsx src/scripts/test-reviewer.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.15.0",
    "@langchain/anthropic": "^1.0.0",
    "@langchain/core": "^1.1.0",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/groq": "^1.3.1",
    "@langchain/langgraph": "^1.4.8",
    "@supabase/supabase-js": "^2.48.0",
    "deepagents": "^1.12.0",
    "dotenv": "^17.0.0",
    "hono": "^4.7.0",
    "langchain": "^1.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
