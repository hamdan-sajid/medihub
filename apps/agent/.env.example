# --- Supabase (required) -----------------------------------------------------
# Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Service role key. Bypasses RLS. Server-side only, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Model provider ----------------------------------------------------------
# google (free tier, default) | anthropic (paid) | groq (free tier)
MEDIHUB_PROVIDER=google

# Free, no card required: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Only needed if MEDIHUB_PROVIDER=anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Only needed if MEDIHUB_PROVIDER=groq — https://console.groq.com/keys
GROQ_API_KEY=

# Override the per-provider default model if you want to.
#   google:    gemini-2.5-flash (default), gemini-2.5-flash-lite, gemini-2.5-pro
#   anthropic: claude-sonnet-5 (default), claude-opus-5
# MEDIHUB_MODEL=

# Client-side pacing, requests per minute. Defaults to the provider's free-tier
# limit. Raise this once you are on a paid tier — it is the main thing making
# runs slow.
# MEDIHUB_RPM=10

# --- Server ------------------------------------------------------------------
PORT=8787
ALLOWED_ORIGINS=http://localhost:3000
